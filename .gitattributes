# dist/ is generated by plugins/product-manager-os/scripts/build_targets.py and
# committed on purpose: a Cursor or Codex user should be able to download the repo
# and copy a folder, without installing Python to build one.
#
# Marking it linguist-generated means GitHub collapses these files in diffs and
# excludes them from language stats — so committing build output costs no review
# noise. CI regenerates dist/ on every push and fails if the committed copy drifts.
dist/** linguist-generated=true
plugins/*/dist/** linguist-generated=true

# Generated docs — same reasoning.
plugins/*/tests/RESULTS.md linguist-generated=true
plugins/*/examples/SAMPLE-OUTPUTS.md linguist-generated=true
plugins/*/workspace/INDEX.md linguist-generated=true
